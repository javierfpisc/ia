FROM python:3.12-slim

RUN pip install --no-cache-dir \
    "mkdocs>=1.6,<2" \
    "mkdocs-material>=9.5,<10" \
    "mkdocs-awesome-pages-plugin>=2.9,<3"

RUN mkdir -p /docs /config
WORKDIR /docs

EXPOSE 8000

CMD ["mkdocs", "serve", "--config-file", "/config/mkdocs.yml", "--dev-addr", "0.0.0.0:8000"]
